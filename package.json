{
  "name": "crud-app",
  "version": "3.3.0",
  "private": true,
  "homepage": "https://pet-app-fccae.web.app",
  "author": {
    "name": "Safdar Jamal",
    "url": "https://safdarjamal.github.io"
  },
  "dependencies": {
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.3.0",
    "browser-image-compression": "^2.0.2",
    "classnames": "^2.5.1",
    "firebase": "^10.7.2",
    "lucide-react": "^0.474.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-google-recaptcha": "^3.1.0",
    "react-hook-form": "^7.54.2",
    "react-icons": "^5.0.1",
    "react-router-dom": "^6.22.0",
    "react-scripts": "^5.0.1",
    "sweetalert2": "^11.4.18"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:coverage": "react-scripts test --coverage --watchAll=false --forceExit",
    "test:ci": "react-scripts test --watchAll=false --forceExit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "react-scripts build && firebase deploy --only hosting",
    "firebase-init": "firebase init"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/index.js",
      "!src/reportWebVitals.js",
      "!src/**/*.stories.*",
      "!src/tests/**",
      "!src/config/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 60,
        "branches": 55,
        "functions": 60,
        "lines": 60
      }
    },
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(lucide-react)/)"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/plugin-transform-runtime": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@playwright/test": "^1.60.0",
    "@testing-library/user-event": "^14.6.1",
    "babel-loader": "^10.0.0",
    "gh-pages": "^4.0.0",
    "msw": "^1.3.5",
    "prettier": "^3.2.5",
    "react-app-rewired": "^2.2.1",
    "tailwindcss": "^3.4.1"
  }
}
