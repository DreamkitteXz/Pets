# Dependencies
node_modules/
functions/node_modules/

# Build output
build/
dist/
coverage/

# Environment
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Assinatura de release — NUNCA versionar.
# android/.gitignore já cobre o diretório android/; estes padrões pegam também
# um keystore solto na raiz do repositório ou em qualquer outra pasta.
key.properties
*.jks
*.keystore
*.p12

# Service account de publicacao (tool/release.dart). Da acesso de ESCRITA ao
# Firestore e ao Storage do projeto — vazar isso e pior que vazar o keystore,
# porque permite publicar um APK malicioso como se fosse a atualizacao oficial.
tool/service-account.json
service-account*.json
*-firebase-adminsdk-*.json

# O site (React/Firebase) vive num repositorio git PROPRIO clonado aqui dentro.
# Sem esta linha o git o registraria como gitlink apontando para um submodulo
# que nao existe — clone limpo viria com a pasta vazia.
/Pets/

# Cache do Firebase CLI (deploy de hosting) e config gerada pelo DevTools.
.firebase/
devtools_options.yaml
