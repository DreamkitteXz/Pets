rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Vaccine label images — readable by any authenticated user;
    // writable by authenticated users with size and content-type constraints.
    match /vaccine-labels/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Deny everything not explicitly covered above.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
