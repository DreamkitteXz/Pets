rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Vaccine label images — readable by any authenticated user;
    // writable by authenticated users with size and content-type constraints.
    match /vaccine-labels/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Fotos de pet — enviadas pelo tutor no app.
    //
    // Escopo por dono: cada usuário só escreve dentro da PRÓPRIA pasta
    // (`pet-photos/{uid}/...`). Rules de Storage não conseguem consultar o
    // Firestore, então não dá para checar `pets.ownerId` aqui; o uid no path é
    // o que amarra o arquivo a quem enviou.
    //
    // Leitura por qualquer autenticado, igual a `vaccine-labels/`: o
    // veterinário precisa ver a foto do paciente no site.
    match /pet-photos/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // APKs de release — distribuicao fora da Play Store.
    //
    // LEITURA PUBLICA (`if true`, sem exigir auth): o download acontece depois
    // de uma checagem que roda ANTES do login, entao exigir autenticacao
    // impediria justamente o caso de atualizacao obrigatoria de quem nao
    // consegue entrar.
    //
    // Signed URL foi descartada: exigiria uma Cloud Function para emiti-la, e
    // essa funcao precisaria ser chamavel sem autenticacao — recria o mesmo
    // acesso publico com mais peca para manter. A integridade do binario vem
    // do `apkSha256` que o app confere apos baixar, nao do sigilo da URL.
    //
    // ESCRITA NEGADA: o APK sobe pelo console ou por script com service
    // account. Cliente poder escrever aqui seria poder distribuir binario
    // arbitrario como se fosse o app.
    // `{version}.apk` e `{version}.json` (manifesto com sha256/tamanho, usado
    // pelo rollback). Releases anteriores NUNCA sao apagadas: sao elas que dao
    // para onde voltar.
    match /releases/android/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Deny everything not explicitly covered above.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
