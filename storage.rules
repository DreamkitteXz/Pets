rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Vaccine label images — readable by any authenticated user;
    // writable by authenticated users with size and content-type constraints.
    match /vaccine-labels/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Fotos de pet — enviadas pelo tutor no app.
    //
    // Escopo por dono: cada usuário só escreve dentro da PRÓPRIA pasta
    // (`pet-photos/{uid}/...`). Rules de Storage não conseguem consultar o
    // Firestore, então não dá para checar `pets.ownerId` aqui; o uid no path é
    // o que amarra o arquivo a quem enviou.
    //
    // Leitura por qualquer autenticado, igual a `vaccine-labels/`: o
    // veterinário precisa ver a foto do paciente no site.
    match /pet-photos/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // APKs de release — distribuição fora da Play Store.
    //
    // LEITURA PÚBLICA (`if true`, sem exigir auth): o download acontece depois
    // de uma checagem que roda ANTES do login, então exigir autenticação
    // impediria justamente o caso de atualização obrigatória de quem não
    // consegue entrar. A integridade do binário vem do `apkSha256` que o app
    // confere após baixar, não do sigilo da URL.
    //
    // `{version}.apk` e `{version}.json` (manifesto com sha256/tamanho, usado
    // pelo rollback). Releases anteriores NUNCA são apagadas: são elas que dão
    // para onde voltar.
    match /releases/android/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Deny everything not explicitly covered above.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
