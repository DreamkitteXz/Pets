rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // OTP codes — Admin SDK only. No client access ever.
    match /otpCodes/{userId} {
      allow read, write: if false;
    }

    // Users — each user can only read/write their own profile.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Pets — readable by owner or any assigned veterinarian.
    // Creatable by any authenticated user (vet registers pet on behalf of owner).
    // Updatable by the vet who created it or the pet owner.
    // Deletable only by the vet who created it.
    match /pets/{petId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.ownerId ||
         resource.data.veterinarians.hasAny([request.auth.uid]));
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.createdBy ||
         request.auth.uid == resource.data.ownerId);
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.createdBy;
    }

    // Vaccines — readable by the registering vet or the pet owner.
    // Updatable by either party (vet validates, owner approves).
    // Deletable only by the registering vet.
    match /vaccines/{vaccineId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.veterinarianId ||
         request.auth.uid == resource.data.ownerId);
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.veterinarianId ||
         request.auth.uid == resource.data.ownerId);
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.veterinarianId;
    }

    // Appointments — managed by the assigned veterinarian.
    match /appointments/{appointmentId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.veterinarianId;
      allow create: if request.auth != null;
    }

    // Clinics — readable by any authenticated user; writable by the clinic owner.
    match /clinics/{clinicId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.auth.uid == resource.data.ownerId;
    }

    // Deworming — same access pattern as vaccines.
    match /deworming/{dewormingId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.veterinarianId ||
         request.auth.uid == resource.data.ownerId);
      allow create: if request.auth != null;
      allow update: if request.auth != null &&
        request.auth.uid == resource.data.veterinarianId;
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.veterinarianId;
    }

    // Deny everything not explicitly covered above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
