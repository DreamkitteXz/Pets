rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // OTP codes — Admin SDK only. No client access ever.
    match /otpCodes/{userId} {
      allow read, write: if false;
    }

    // Users — cada usuário lê e escreve o PRÓPRIO perfil, mas não os campos que
    // decidem acesso:
    //  • role: definido UMA vez (onboarding) e nunca trocado pelo cliente.
    //    Antes, qualquer tutor podia se declarar `veterinarian` e validar vacina.
    //  • status: o cliente só avança `pending` → `active` (onboarding). Nunca sai
    //    de `suspended` sozinho.
    //  • emailVerified: só pode refletir o token do Auth (cadastro com Google
    //    grava `true` legitimamente). Fora isso, só a CF `verifyOtp` (Admin SDK).
    //  • delete negado: apagar e recriar o doc seria um jeito de trocar de role.
    match /users/{userId} {
      function isSelf()    { return request.auth != null && request.auth.uid == userId; }
      function incoming()  { return request.resource.data; }
      function changed()   { return incoming().diff(resource.data).affectedKeys(); }
      function validRole(r) { return r in ['tutor', 'veterinarian']; }
      function verifiedOk() {
        return !('emailVerified' in incoming())
          || incoming().emailVerified == false
          || incoming().emailVerified == request.auth.token.email_verified;
      }

      allow read: if isSelf();
      allow create: if isSelf()
        && (!('role' in incoming()) || validRole(incoming().role))
        && (!('status' in incoming()) || incoming().status in ['pending', 'active'])
        && verifiedOk();
      allow update: if isSelf()
        && (!changed().hasAny(['role'])
            || (resource.data.get('role', null) == null && validRole(incoming().role)))
        && (!changed().hasAny(['status'])
            || (resource.data.get('status', 'pending') == 'pending' && incoming().status == 'active'))
        && (!changed().hasAny(['emailVerified']) || verifiedOk());
      allow delete: if false;

      match /notifications/{notificationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Pets — readable by owner or any assigned veterinarian.
    // Creatable by any authenticated user (vet registers pet on behalf of owner).
    // Updatable by the vet who created it or the pet owner.
    // Deletable only by the vet who created it.
    match /pets/{petId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.ownerId ||
         resource.data.veterinarians.hasAny([request.auth.uid]));
      // Quem cria assina (`createdBy`) e só pode criar pet SEU (tutor) ou de
      // paciente a que se vincula (vet em `veterinarians`). Antes qualquer
      // autenticado criava pet com qualquer `ownerId`.
      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && (request.resource.data.ownerId == request.auth.uid
            || (request.resource.data.get('veterinarians', []) is list
                && request.resource.data.veterinarians.hasAny([request.auth.uid])));
      // Dono e autor editam, mas ninguém troca o dono nem a autoria pelo cliente.
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.createdBy ||
         request.auth.uid == resource.data.ownerId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'createdBy']);
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.createdBy;

      // Pesagens (`pesos`) — ÚNICA linha do tempo de peso do pet, compartilhada
      // entre web e app. O vet escreve tudo (pesagem clínica). O DONO só pode
      // CRIAR o próprio auto-relato, marcado com `source: 'tutor'`; não edita
      // nem apaga, e não pode se passar por pesagem do vet.
      //
      // Regras casadas são OR: este bloco só ADICIONA o create do dono — o
      // acesso do vet continua vindo do `{record=**}` abaixo.
      match /pesos/{pesoId} {
        function pet()     { return get(/databases/$(database)/documents/pets/$(petId)).data; }
        function isVet()   { return pet().veterinarians.hasAny([request.auth.uid]); }
        function isOwner() { return pet().ownerId == request.auth.uid; }

        allow read: if request.auth != null && (isVet() || isOwner());
        allow create: if request.auth != null && (
          isVet() ||
          (isOwner()
            && request.resource.data.source == 'tutor'
            && request.resource.data.registeredBy == request.auth.uid
            && request.resource.data.weight is number
            && request.resource.data.weight > 0)
        );
        allow update, delete: if request.auth != null && isVet();
      }

      // Prontuário — subcoleções clínicas (consultas, pesos e futuros tipos).
      // Leitura: vet vinculado OU tutor dono. Escrita: somente vet vinculado
      // (o tutor visualiza o prontuário em modo leitura).
      match /{record=**} {
        allow read: if request.auth != null && (
          get(/databases/$(database)/documents/pets/$(petId)).data.veterinarians.hasAny([request.auth.uid]) ||
          get(/databases/$(database)/documents/pets/$(petId)).data.ownerId == request.auth.uid
        );
        allow write: if request.auth != null &&
          get(/databases/$(database)/documents/pets/$(petId)).data.veterinarians.hasAny([request.auth.uid]);
      }
    }

    // Vaccines — registro clínico com autoridade do veterinário.
    //  • status e validationDetails: só mudam via Cloud Function (admin) — cliente NUNCA.
    //  • tutor (dono): só pode marcar ciência (tutorAcknowledged/At).
    //  • vet (responsável): edita campos clínicos enquanto pending; congelado após
    //    approved/rejected (só soft-delete).
    //  • exclusão é LÓGICA (active:false) — hard delete negado.
    match /vaccines/{vaccineId} {
      function isVet()   { return request.auth.uid == resource.data.veterinarianId; }
      function isOwner() { return request.auth.uid == resource.data.ownerId; }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function frozen()  { return resource.data.status == 'approved' || resource.data.status == 'rejected'; }
      function touchesProtected() { return changed().hasAny(['status', 'validationDetails']); }
      function tutorAckOnly()   { return changed().hasOnly(['tutorAcknowledged', 'tutorAcknowledgedAt', 'updatedAt']); }
      function softDeleteOnly() {
        return changed().hasOnly(['active', 'deletedAt', 'deletedBy', 'updatedAt'])
          && request.resource.data.active == false
          && request.resource.data.deletedBy == request.auth.uid;
      }

      allow read: if request.auth != null && (isVet() || isOwner());
      allow create: if request.auth != null && tutorPendingCreate(request.resource.data.petId);
      allow update: if request.auth != null && !touchesProtected() && (
        (isOwner() && tutorAckOnly()) ||
        (isVet() && softDeleteOnly()) ||
        (isVet() && !frozen() && !changed().hasAny(identityFields()))
      );
      allow delete: if false;
    }

    // Criação de vacina/vermífugo PELO CLIENTE = só a submissão do tutor, que
    // nasce `pending` e espera o veterinário. Antes `create` aceitava qualquer
    // documento, inclusive um já `approved` com validationDetails forjado — a
    // carteira em PDF exibia isso como "validado pelo veterinário".
    //
    // O registro do veterinário (que nasce aprovado) passa pela CF
    // `createVaccineRecord`, que confere no servidor que quem chama é vet ativo
    // vinculado ao pet.
    //
    // `validationDetails` é aceito só no formato que o app (build 7) já grava:
    // `vetValidation` pendente e sem validador.
    // Edição clínica do vet (enquanto pending) não mexe na identidade do registro
    // nem na exclusão lógica: mover para o pet/dono de outra pessoa ou "apagar"
    // com autoria falsa passavam pelo ramo `isVet() && !frozen()`.
    function identityFields() {
      return ['ownerId', 'petId', 'veterinarianId', 'createdBy',
              'active', 'deletedAt', 'deletedBy'];
    }

    function tutorPendingCreate(petId) {
      let d = request.resource.data;
      let pet = get(/databases/$(database)/documents/pets/$(petId)).data;
      return d.status == 'pending'
        && d.ownerId == request.auth.uid
        && pet.ownerId == request.auth.uid
        && d.get('tutorAcknowledged', false) == false
        && d.get('active', true) == true
        && (!('validationDetails' in d)
            || (d.validationDetails.keys().hasOnly(['vetValidation'])
                && d.validationDetails.vetValidation.status == 'pending'
                && d.validationDetails.vetValidation.get('validatedBy', null) == null));
    }

    // Appointments — managed by the assigned veterinarian.
    match /appointments/{appointmentId} {
      allow read, write: if request.auth != null &&
        request.auth.uid == resource.data.veterinarianId;
      allow create: if request.auth != null;
    }

    // Clínicas — leitura aberta a qualquer autenticado.
    //
    // O tutor precisa escolher a clínica ao registrar uma vacina no app, e o
    // documento só tem dado comercial: nome, CNPJ, telefone, e-mail e endereço
    // do estabelecimento. Nada disso é privado — é o que está na fachada e no
    // cadastro público da Receita.
    //
    // O array `veterinarians` também fica visível, e é justamente ele que
    // permite ao app derivar a clínica de um veterinário sem duplicar o
    // vínculo em outro lugar. São uids, não credenciais.
    //
    // ESCRITA inalterada: continua exigindo que o solicitante seja um dos
    // veterinários da clínica. Como `resource.data` é nulo num create, isso
    // também segue impedindo que um cliente crie clínica — só console ou
    // Admin SDK.
    match /clinics/{clinicId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        resource.data.veterinarians.hasAny([request.auth.uid]);
    }

    // Diretório público de veterinários — projeção de `users`.
    //
    // Existe porque o app precisa listar veterinários para o tutor associar a
    // uma vacina, mas o documento em `users` guarda cpf, email, phone e o
    // endereço residencial completo. Abrir consulta por `role` em `users`
    // entregaria tudo isso a qualquer tutor; então `users` continua fechado e
    // este documento carrega só name, crmv, specialties e yearsOfExperience.
    //
    // ESCRITA NEGADA A TODO CLIENTE. Quem preenche é a Function
    // `mirrorVetDirectory`, disparada por escrita em `users/{uid}` — o Admin
    // SDK ignora rules. Se o cliente pudesse escrever aqui, qualquer um
    // publicaria um CRMV falso e apareceria como veterinário no app.
    match /vet_directory/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Deworming — mesmo padrão de vaccines (eixo único de status + ciência + soft-delete).
    match /deworming/{dewormingId} {
      function isVet()   { return request.auth.uid == resource.data.veterinarianId; }
      function isOwner() { return request.auth.uid == resource.data.ownerId; }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      function frozen()  { return resource.data.status == 'approved' || resource.data.status == 'rejected'; }
      function touchesProtected() { return changed().hasAny(['status', 'validationDetails']); }
      function tutorAckOnly()   { return changed().hasOnly(['tutorAcknowledged', 'tutorAcknowledgedAt', 'updatedAt']); }
      function softDeleteOnly() {
        return changed().hasOnly(['active', 'deletedAt', 'deletedBy', 'updatedAt'])
          && request.resource.data.active == false
          && request.resource.data.deletedBy == request.auth.uid;
      }

      allow read: if request.auth != null && (isVet() || isOwner());
      allow create: if request.auth != null && tutorPendingCreate(request.resource.data.petId);
      allow update: if request.auth != null && !touchesProtected() && (
        (isOwner() && tutorAckOnly()) ||
        (isVet() && softDeleteOnly()) ||
        (isVet() && !frozen() && !changed().hasAny(identityFields()))
      );
      allow delete: if false;
    }

    // Conversas (chat) — apenas os dois participantes (vet e tutor) acessam.
    // Só o veterinário pode criar a conversa.
    match /conversas/{conversaId} {
      allow read, update, delete: if request.auth != null &&
        (resource.data.vetId == request.auth.uid ||
         resource.data.tutorId == request.auth.uid);
      allow create: if request.auth != null &&
        request.resource.data.vetId == request.auth.uid;

      // Mensagens — herdam o acesso da conversa pai.
      match /mensagens/{msgId} {
        allow read, write: if request.auth != null && (
          get(/databases/$(database)/documents/conversas/$(conversaId)).data.vetId == request.auth.uid ||
          get(/databases/$(database)/documents/conversas/$(conversaId)).data.tutorId == request.auth.uid
        );
      }
    }

    // Catálogo controlado (vacinas/vermífugos) — leitura por qualquer autenticado;
    // escrita só via Admin SDK (seed/migração), nunca pelo cliente.
    match /vaccineCatalog/{itemId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /dewormerCatalog/{itemId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Canal de versao do app (distribuicao fora da Play Store).
    //
    // LEITURA PUBLICA, de proposito: a checagem roda ANTES do login. Se uma
    // mudanca de schema quebrar a versao antiga, o proprio login pode ser o
    // que quebra — exigir autenticacao aqui impediria forcar a atualizacao de
    // quem nao consegue entrar. O documento nao tem nada sensivel: versao,
    // changelog e URL de download sao informacao de pagina publica de release.
    //
    // ESCRITA NEGADA A TODO CLIENTE. So console ou script com service account
    // (o Admin SDK ignora rules). Este documento controla o killswitch
    // `minSupportedBuildNumber` — cliente poder escrever seria poder travar o
    // app de todo mundo.
    match /app_config/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Deny everything not explicitly covered above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
